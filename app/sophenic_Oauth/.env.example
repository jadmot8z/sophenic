# SOPHENIC secrets - do not commit real keys

# URL publique de l'application (Supabase/Stripe et liens serveur)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth développeur — GitHub
# Callback à enregistrer: http://localhost:3000/api/connections/github/callback
SOPHENIC_GITHUB_CLIENT_ID=
SOPHENIC_GITHUB_CLIENT_SECRET=
SOPHENIC_GITHUB_OAUTH_SCOPES=read:user user:email repo

# Vercel Desktop — recommandé : Personal Access Token (Settings → Tokens)
# Les tokens personnels Vercel récents commencent typiquement par vcp_.
# Aucun Client ID ni callback n'est nécessaire dans ce mode.
SOPHENIC_VERCEL_TOKEN=

# Vercel OAuth App — optionnel, uniquement si vous avez créé une App OAuth Vercel
# Callback Web: http://localhost:3000/api/connections/vercel/callback
SOPHENIC_VERCEL_CLIENT_ID=
SOPHENIC_VERCEL_CLIENT_SECRET=
SOPHENIC_VERCEL_OAUTH_SCOPES=openid email profile offline_access

# Optionnel si l'origine visible par les fournisseurs diffère de l'origine HTTP reçue
SOPHENIC_OAUTH_BASE_URL=

# Optionnel: clé dédiée au chiffrement AES-GCM des tokens OAuth.
# Si absente, SOPHENIC dérive la clé depuis SUPABASE_SERVICE_ROLE_KEY côté serveur.
SOPHENIC_CONNECTIONS_ENCRYPTION_KEY=

# Compatibilité du moteur Code local / CLI
SOPHENIC_GITHUB_TOKEN=

# OAuth Desktop natif (Electron) — recommandé pour `npm run sophenic:start`
# Les boutons GitHub/Vercel utilisent un serveur callback loopback dédié,
# sans dépendre de Supabase ni des cookies du navigateur externe.
SOPHENIC_OAUTH_LOOPBACK_PORT=43821
# GitHub Redirect URI: http://127.0.0.1:43821/oauth/github/callback
# En mode SOPHENIC_VERCEL_TOKEN, Vercel ne nécessite aucun callback.
# Si vous choisissez explicitement le mode Vercel OAuth App :
# Vercel Callback URL: http://127.0.0.1:43821/oauth/vercel/callback
SOPHENIC_VERCEL_CLIENT_AUTH=client_secret_post
